# ===== Copia este archivo a .env y ajusta los valores. NUNCA subas .env a Git. =====

# --- Puertos (host) ---
APP_PORT=8080            # puerto por el que abres la aplicacion en el navegador
SERVER_PORT=8080         # puerto interno de Spring Boot
POSTGRES_PORT=5432       # puerto de PostgreSQL expuesto en el host

# --- Perfil y zona horaria ---
SPRING_PROFILES_ACTIVE=dev      # dev | prod (prod exige ADMIN_PASSWORD real y cookies seguras)
APP_TIMEZONE=America/Bogota
COOKIE_SECURE=false             # true si sirves la app por HTTPS
DEV_ENDPOINTS=true              # simulador de WhatsApp (/api/dev/*). PON false EN PRODUCCION

# --- Base de datos ---
DB_NAME=fruver
DB_USER=fruver
DB_PASSWORD=change_me           # cambialo

# --- Usuarios iniciales (se crean al primer arranque si no existen) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me        # cambialo. En prod la app NO arranca con este valor
OPERATOR_USERNAME=operador
OPERATOR_PASSWORD=              # opcional: si lo defines se crea un usuario OPERADOR

# --- IA (Spring AI / OpenAI) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com   # otro proveedor compatible con la API de OpenAI
AI_MODEL=gpt-4o-mini
HTTP_READ_TIMEOUT=30s
STT_MODEL=whisper-1                       # transcripcion de audios

# --- Politica conversacional ---
AI_AUTO_REPLY=false                # true: la IA envia sola las preguntas de aclaracion
AUTO_CONFIRM_CLEAR_ORDERS=false    # true: envia sola la confirmacion cuando el pedido esta GREEN

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_ENABLED=false
WHATSAPP_VERIFY_TOKEN=change_me_verify_token
WHATSAPP_APP_SECRET=your_meta_app_secret        # valida la firma X-Hub-Signature-256
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_API_VERSION=v21.0

# --- Audio ---
AUDIO_STORAGE_TYPE=local
AUDIO_STORAGE_PATH=/data/audio

# --- Impresora termica ---
PRINTER_ENABLED=false     # false: el ticket se escribe en el log (simulada)
PRINTER_TYPE=ESC_POS
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100
PRINTER_COLUMNS=42        # 32 = papel 58 mm, 42 o 48 = papel 80 mm
PRINTER_MAX_ATTEMPTS=3
SHOP_NAME=FRUVER

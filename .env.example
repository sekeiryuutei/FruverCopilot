# ===== Copia este archivo a .env y ajusta los valores. NUNCA subas .env a Git. =====

# --- Puertos (host) ---
APP_PORT=8085            # puerto por el que abres la aplicacion en el navegador
SERVER_PORT=8080         # puerto interno de Spring Boot
POSTGRES_PORT=5439       # puerto de PostgreSQL expuesto en el host

# --- Perfil y zona horaria ---
SPRING_PROFILES_ACTIVE=dev      # dev | prod (prod exige ADMIN_PASSWORD real >=12, COOKIE_SECURE=true, DEV_ENDPOINTS=false)
APP_TIMEZONE=America/Bogota
COOKIE_SECURE=false             # true OBLIGATORIO si sirves por HTTPS (prod). La app no arranca en prod con false.
DEV_ENDPOINTS=false             # true solo en desarrollo local (simulador /api/dev/* sin CSRF pero con clave). PON false EN PRODUCCION

# --- Datos de demostracion (solo desarrollo; la app NO arranca con esto en prod) ---
SEED_DEMO_DATA=false            # true: carga 6 productos y los pedidos demo #10003, #10004 (aprobados) y #10005 (por revisar)
SEED_DEMO_RESET=false           # true: al arrancar borra y recrea los pedidos demo (para repetir la demo)

# --- Base de datos ---
DB_NAME=fruver
DB_USER=fruver
DB_PASSWORD=change_me           # >=12 caracteres, unico. NUNCA reutilices la clave de admin/operador.

# --- Usuarios iniciales (se crean al primer arranque si no existen) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me        # >=12 caracteres. En prod la app NO arranca con 'change_me' ni claves debiles.
OPERATOR_USERNAME=operador
OPERATOR_PASSWORD=              # opcional, pero si lo defines usa clave DISTINTA a la de admin (>=12)

# --- IA (Adapter: gemini | openai | mock) ---
AI_PROVIDER=gemini                     # 'gemini' (recomendado) | 'openai' | 'mock' (offline)
GEMINI_API_KEY=your_gemini_api_key     # Google AI Studio (https://aistudio.google.com) - Capa gratuita
GEMINI_MODEL=gemini-2.5-flash          # Modelo multimodal rapido
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# --- OpenAI (Opcional, si usas AI_PROVIDER=openai) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com   # o proveedor compatible
AI_MODEL=gpt-4o-mini
STT_MODEL=whisper-1                       # transcripcion de audios
HTTP_READ_TIMEOUT=30s

# --- Politica conversacional ---
AI_AUTO_REPLY=false                # true: la IA envia sola las preguntas de aclaracion
AUTO_CONFIRM_CLEAR_ORDERS=false    # true: envia sola la confirmacion cuando el pedido esta GREEN

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_ENABLED=false
WHATSAPP_VERIFY_TOKEN=change_me_verify_token
WHATSAPP_APP_SECRET=your_meta_app_secret        # valida la firma X-Hub-Signature-256
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_API_VERSION=v21.0

# --- Audio ---
AUDIO_STORAGE_TYPE=local
AUDIO_STORAGE_PATH=/data/audio

# --- Impresora termica ---
PRINTER_ENABLED=false     # false: el ticket se escribe en el log (simulada)
PRINTER_TYPE=ESC_POS
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100
PRINTER_COLUMNS=42        # 32 = papel 58 mm, 42 o 48 = papel 80 mm
PRINTER_MAX_ATTEMPTS=3
SHOP_NAME=FRUVER
